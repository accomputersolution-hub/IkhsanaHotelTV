<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Cold-start / system splash → branded SplashActivity -->
    <style name="Theme.PcnCloudTv.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.PcnCloudTv</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!--
      Main app theme: dark home-matching window fill so Compose route swaps never
      flash AppCompat / Material blue through a destroyed Home destination.
    -->
    <style name="Theme.PcnCloudTv" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/dark_bg_or_transparent</item>
        <item name="android:colorBackground">@color/dark_bg_or_transparent</item>
        <item name="android:statusBarColor">@color/dark_bg_or_transparent</item>
        <item name="android:navigationBarColor">@color/dark_bg_or_transparent</item>
        <item name="colorPrimary">@color/dark_bg_or_transparent</item>
        <item name="colorPrimaryDark">@color/dark_bg_or_transparent</item>
        <item name="colorAccent">@color/splash_gold</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowAnimationStyle">@style/Theme.PcnCloudTv.NoAnimation</item>
        <item name="android:windowDisablePreview">true</item>
        <!-- Disable platform square focus highlight on Android TV (API 26+) -->
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="android:colorControlHighlight">@android:color/transparent</item>
        <item name="colorControlHighlight">@android:color/transparent</item>
        <item name="android:selectableItemBackground">@drawable/focus_transparent</item>
        <!-- Keep non-fullscreen so adjustPan can shift content above the IME on TV -->
        <item name="android:windowFullscreen">false</item>
    </style>

    <style name="Theme.PcnCloudTv.NoAnimation">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
        <item name="android:taskOpenEnterAnimation">@null</item>
        <item name="android:taskOpenExitAnimation">@null</item>
        <item name="android:taskCloseEnterAnimation">@null</item>
        <item name="android:taskCloseExitAnimation">@null</item>
        <item name="android:taskToFrontEnterAnimation">@null</item>
        <item name="android:taskToFrontExitAnimation">@null</item>
    </style>
</resources>
