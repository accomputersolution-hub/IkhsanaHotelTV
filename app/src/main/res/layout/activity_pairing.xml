<?xml version="1.0" encoding="utf-8"?>
<!--
  TV pairing: staff enters public hotel slug, TV shows a 6-digit code.
  Reception claims the code in Admin (Pair Device Code) and binds a room.
  Guests never type a room number on the TV.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pairing_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1325"
    android:fillViewport="true"
    android:isScrollContainer="true"
    android:clipToPadding="false"
    android:padding="24dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="400dp">

        <LinearLayout
            android:id="@+id/pairing_card"
            android:layout_width="640dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="16dp"
            android:background="@drawable/bg_pairing_card"
            android:orientation="vertical"
            android:paddingLeft="40dp"
            android:paddingTop="36dp"
            android:paddingRight="40dp"
            android:paddingBottom="36dp">

            <TextView
                android:id="@+id/pairing_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/pairing_title"
                android:textColor="#E8D5A3"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pairing_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/pairing_subtitle"
                android:textColor="#94A3B8"
                android:textSize="14sp" />

            <!-- Step 1: public slug -->
            <LinearLayout
                android:id="@+id/pairing_slug_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pairing_hotel_id_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/pairing_public_slug_label"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etHotelId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_pairing_field"
                    android:hint="@string/pairing_public_slug_hint"
                    android:imeOptions="actionDone|flagNoExtractUi"
                    android:inputType="text|textNoSuggestions"
                    android:maxLines="1"
                    android:nextFocusDown="@id/btnPair"
                    android:nextFocusForward="@id/btnPair"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:singleLine="true"
                    android:textColor="#F1F5F9"
                    android:textColorHint="#64748B"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnPair"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_pairing_button"
                    android:paddingVertical="14dp"
                    android:text="@string/pairing_generate_code"
                    android:textAllCaps="false"
                    android:textColor="#F1F5F9"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Step 2: show 6-digit code (hidden until generated) -->
            <LinearLayout
                android:id="@+id/pairing_code_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/pairing_code_instruction"
                    android:textColor="#94A3B8"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvPairingCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:letterSpacing="0.35"
                    android:textColor="#E8D5A3"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    tools:text="482913" />

                <TextView
                    android:id="@+id/tvPairingHotelName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textColor="#64748B"
                    android:textSize="13sp"
                    tools:text="Hotel name" />

                <TextView
                    android:id="@+id/tvPairingWaiting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/pairing_waiting"
                    android:textColor="#94A3B8"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnNewCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_pairing_button"
                    android:paddingVertical="14dp"
                    android:text="@string/pairing_new_code"
                    android:textAllCaps="false"
                    android:textColor="#F1F5F9"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Legacy room field kept gone — room is assigned by reception claim -->
            <EditText
                android:id="@+id/etRoomNumber"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvPairError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="#FB7185"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</ScrollView>
