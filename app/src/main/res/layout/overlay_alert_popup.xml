<?xml version="1.0" encoding="utf-8"?>
<!-- SYSTEM_ALERT_WINDOW popup shown by AlertOverlayService over YouTube / Live TV. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alert_overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="48dp"
    android:clipChildren="false">

    <LinearLayout
        android:id="@+id/alert_overlay_card"
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:paddingTop="32dp"
        android:paddingBottom="28dp"
        android:background="@drawable/bg_alert_overlay_card"
        android:elevation="16dp">

        <TextView
            android:id="@+id/alert_overlay_eyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/alert_overlay_eyebrow"
            android:textAllCaps="true"
            android:textColor="#C9A962"
            android:textSize="13sp"
            android:letterSpacing="0.12"
            android:gravity="center"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/alert_overlay_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#F8FAFC"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="3"
            android:ellipsize="end"
            android:fontFamily="serif" />

        <TextView
            android:id="@+id/alert_overlay_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#C5CDD8"
            android:textSize="17sp"
            android:lineSpacingExtra="4dp"
            android:gravity="center"
            android:maxLines="8"
            android:ellipsize="end"
            android:fontFamily="sans-serif" />

        <Button
            android:id="@+id/alert_overlay_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:minWidth="160dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/alert_overlay_close"
            android:textAllCaps="false"
            android:textColor="#0B1325"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_alert_overlay_close" />
    </LinearLayout>
</FrameLayout>
