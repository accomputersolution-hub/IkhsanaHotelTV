<?xml version="1.0" encoding="utf-8"?>
<!--
  Screen Cast & Mirroring — 1080p TV split layout.
  Left: Android / Chromecast instructions (read-only).
  Right: Apple / AirPlay with focusable Start button.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/castDialogRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cast_dialog_scrim"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="false"
    android:padding="48dp">

    <LinearLayout
        android:id="@+id/castDialogPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@drawable/bg_alert_overlay_card"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="32dp"
        android:paddingEnd="40dp"
        android:paddingBottom="28dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/btnCastClose"
                android:layout_marginEnd="24dp"
                android:focusable="false"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtCastTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/cast_dialog_title"
                    android:textColor="@color/splash_gold"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/txtCastSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:focusable="false"
                    android:text="@string/cast_dialog_subtitle"
                    android:textColor="@color/splash_text_muted"
                    android:textSize="18sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnCastClose"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_cast_close_button"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:minWidth="120dp"
                android:nextFocusDown="@id/btnStartAirPlay"
                android:nextFocusLeft="@id/cardAndroidCast"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/cast_dialog_close"
                android:textAllCaps="false"
                android:textColor="@color/splash_text_primary"
                android:textSize="16sp" />
        </RelativeLayout>

        <!-- Side-by-side cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="28dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:focusable="false"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Card 1: Android / Chromecast -->
            <LinearLayout
                android:id="@+id/cardAndroidCast"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="14dp"
                android:layout_weight="1"
                android:background="@drawable/bg_cast_card"
                android:descendantFocusability="blocksDescendants"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusRight="@id/btnStartAirPlay"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:id="@+id/txtAndroidBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cast_close_button"
                    android:focusable="false"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:text="@string/cast_android_badge"
                    android:textColor="@color/splash_gold"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtAndroidTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:focusable="false"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/cast_android_title"
                    android:textColor="@color/splash_text_primary"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/txtAndroidBody"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="18dp"
                    android:layout_weight="1"
                    android:focusable="false"
                    android:lineSpacingExtra="8dp"
                    android:text="@string/cast_android_body"
                    android:textColor="@color/splash_text_muted"
                    android:textSize="18sp"
                    tools:text="1. Connect…" />
            </LinearLayout>

            <!-- Card 2: Apple / AirPlay -->
            <LinearLayout
                android:id="@+id/cardAppleCast"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:background="@drawable/bg_cast_card"
                android:clipChildren="false"
                android:focusable="false"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:id="@+id/txtAppleBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cast_close_button"
                    android:focusable="false"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:text="@string/cast_apple_badge"
                    android:textColor="@color/splash_gold"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtAppleTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:focusable="false"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/cast_apple_title"
                    android:textColor="@color/splash_text_primary"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/txtAppleBody"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="18dp"
                    android:layout_weight="1"
                    android:focusable="false"
                    android:lineSpacingExtra="8dp"
                    android:text="@string/cast_apple_body"
                    android:textColor="@color/splash_text_muted"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/btnStartAirPlay"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_cast_primary_button"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusUp="@+id/btnCastClose"
                    android:nextFocusLeft="@+id/cardAndroidCast"
                    android:text="@string/cast_start_airplay"
                    android:textAllCaps="false"
                    android:textColor="@color/navy_deep"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
