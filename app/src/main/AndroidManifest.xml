<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="in.pcncloud.hotel">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required for BootReceiver to receive system boot broadcasts -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.QUICKBOOT_POWERON" />
    <!--
      SYSTEM_ALERT_WINDOW ("Display over other apps"):
      - Android 10+ BAL exemptions for BootReceiver PendingIntent launches
      - Android 9 (API < 30) HOME reclaim / overlay protection when System UI
        swallows KEYCODE_HOME before the Activity can consume it
      Runtime grant via Settings.canDrawOverlays (requested in SplashActivity).
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <!-- Required on Android 11+ so PackageManager can resolve IPTV / OTT apps -->
    <queries>
        <package android:name="com.ektv.pro" />
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.amazon.amazonvideo.livingroom" />
        <package android:name="in.startv.hotstar" />
        <package android:name="com.graymatrix.did" />
        <package android:name="com.jio.media.ondemand" />
        <package android:name="com.sonyliv" />
        <package android:name="com.spotify.tv.android" />
        <package android:name="com.android.vending" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="play.google.com" />
        </intent>
    </queries>

    <!--
      Headscale may be HTTP (LAN) or HTTPS (ngrok). Cleartext + networkSecurityConfig
      trust system/user CAs so control-plane TLS is not blocked on Android TV.
    -->
    <application
        android:name=".HotelTvApplication"
        android:allowBackup="true"
        android:banner="@drawable/pcn_banner"
        android:icon="@drawable/pcn_logo"
        android:label="${appName}"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:directBootAware="true"
        android:theme="@style/Theme.PcnCloudTv"
        tools:ignore="GoogleAppIndexingWarning">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:defaultFocusHighlightEnabled="false"
            android:theme="@style/Theme.PcnCloudTv.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:directBootAware="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleInstance"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:defaultFocusHighlightEnabled="false"
            android:theme="@style/Theme.HotelTv.BootSplash"
            android:banner="@drawable/pcn_banner"
            android:icon="@drawable/pcn_logo"
            android:label="@string/app_name">
            <!-- App drawer / Leanback launcher entry -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Required for OS Home button / set-home-activity (must be a separate filter) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PairingActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:defaultFocusHighlightEnabled="false"
            android:windowSoftInputMode="adjustPan|stateHidden"
            android:theme="@style/Theme.PcnCloudTv" />

        <!--
          Auto-launch hotel UI after reboot / OEM quick-boot / Direct Boot.
          Requires RECEIVE_BOOT_COMPLETED + QUICKBOOT_POWERON.
          directBootAware + LOCKED_BOOT_COMPLETED cover pre-unlock Android TV boots.
          Separate intent-filters (no CATEGORY_DEFAULT) so system boot intents match.
        -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.android.internal.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!--
          Device Owner admin receiver — required for true Lock Task / Home suppression
          and (corporate) Always-On VPN pinned to THIS app's built-in VpnService.
          Provision once (factory-reset TV, no Google account):
          Hotel:     adb shell dpm set-device-owner in.pcncloud.hotel/in.pcncloud.hotel.kiosk.MyDeviceAdminReceiver
          Corporate: adb shell dpm set-device-owner in.pcncloud.corporate/in.pcncloud.hotel.kiosk.MyDeviceAdminReceiver
        -->
        <receiver
            android:name="in.pcncloud.hotel.kiosk.MyDeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true"
            android:enabled="true"
            android:directBootAware="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
          Optional kiosk keep-alive. START_STICKY must never relaunch UI on its own;
          bring-to-front is gated by KioskPolicy (kiosk ON or crash recovery only).
        -->
        <service
            android:name=".kiosk.KioskWatchdogService"
            android:enabled="true"
            android:exported="false"
            android:directBootAware="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Hotel TV optional kiosk keep-alive; does not relaunch UI on minimize" />
        </service>

        <!-- Embedded libtailscale keep-alive + in-process VpnService TUN. -->
        <service
            android:name=".tailscale.embed.EmbeddedTailscaleKeepAliveService"
            android:enabled="true"
            android:exported="false"
            android:directBootAware="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Re-assert embedded Tailscale VPN after boot" />
        </service>

        <service
            android:name=".tailscale.embed.EmbeddedTailscaleVpnService"
            android:exported="false"
            android:directBootAware="true"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Embedded Tailscale TUN — per-app split for Live TV" />
        </service>

        <!--
          Guest alert popup over YouTube / Live TV via SYSTEM_ALERT_WINDOW.
          Started from HomeViewModel when a new Firestore alert arrives.
        -->
        <service
            android:name=".alert.AlertOverlayService"
            android:enabled="true"
            android:exported="false"
            android:directBootAware="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Hotel TV guest message overlay over third-party apps" />
        </service>

        <!--
          Ultra-lightweight Home key eater (Accessibility).
          Swallows KEYCODE_HOME / OEM 228 only — no reclaim logic.
          Screen Pinning + PendingIntent remain the safety net if this is disabled.
          Staff must enable once: Settings → Accessibility → Hotel TV Home Key Interceptor
        -->
        <service
            android:name=".kiosk.HomeKeyInterceptorService"
            android:exported="true"
            android:enabled="true"
            android:directBootAware="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/home_key_interceptor_label">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
