<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Hotel flavor: suppress Android 12+ launcher icon splash so only
         the in-layout branding appears on SplashActivity. -->
    <style name="Theme.PcnCloudTv.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.PcnCloudTv</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowFullscreen">true</item>
    </style>

</resources>
