<?xml version="1.0" encoding="utf-8"?>
<!-- TV D-Pad focus selector: golden glow border when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/premium_charcoal" />
            <stroke
                android:width="3dp"
                android:color="@color/premium_focus_stroke" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/premium_charcoal" />
            <stroke
                android:width="2dp"
                android:color="@color/premium_gold" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/premium_navy_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/premium_card_stroke" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
