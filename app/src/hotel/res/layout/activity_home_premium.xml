<?xml version="1.0" encoding="utf-8"?>
<!--
  Hotel-flavor only premium 5-star home dashboard.
  Overrides nothing in src/main — inflate from PremiumHomeActivity / AndroidView.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/premium_home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_premium_home"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="48dp"
    android:paddingTop="28dp"
    android:paddingEnd="48dp"
    android:paddingBottom="28dp"
    tools:deviceIds="tv">

    <!-- ── Header: brand (left) ─────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/premium_header_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/premium_hotel_logo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/premium_hotel_name"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_app_logo" />

        <TextView
            android:id="@+id/premium_hotel_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:letterSpacing="0.08"
            android:text="@string/premium_hotel_name"
            android:textAllCaps="true"
            android:textColor="@color/premium_white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ── Header: status (right) ───────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/premium_header_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/premium_room_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_room_badge"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="@string/premium_room_badge"
            android:textColor="@color/premium_gold_light"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/premium_wifi_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_premium_wifi" />

        <TextView
            android:id="@+id/premium_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/premium_sample_time"
            android:textColor="@color/premium_white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/premium_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/premium_sample_date"
            android:textColor="@color/premium_white_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ── Center greeting ──────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/premium_greeting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:gravity="start"
        android:maxLines="1"
        android:text="@string/premium_welcome_guest"
        android:textColor="@color/premium_white"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/premium_header_brand" />

    <!-- ── TOP ROW: 3 large immersive cards ─────────────────────────────── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_entertainment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="10dp"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusDown="@+id/card_live_tv"
        android:nextFocusRight="@+id/card_order_food"
        android:foreground="@drawable/focus_border_large"
        android:stateListAnimator="@animator/premium_card_raise"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toTopOf="@+id/card_live_tv"
        app:layout_constraintEnd_toStartOf="@+id/card_order_food"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/premium_greeting"
        app:layout_constraintVertical_weight="1.35"
        app:strokeColor="@color/premium_card_stroke"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_card_entertainment" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_premium_card_scrim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_premium_icon_circle"
                    android:contentDescription="@null"
                    android:padding="16dp"
                    android:src="@drawable/ic_premium_entertainment" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/premium_card_entertainment"
                    android:textColor="@color/premium_white"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_order_food"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusDown="@+id/card_laundry"
        android:nextFocusLeft="@+id/card_entertainment"
        android:nextFocusRight="@+id/card_guest_services"
        android:foreground="@drawable/focus_border_large"
        android:stateListAnimator="@animator/premium_card_raise"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="@id/card_entertainment"
        app:layout_constraintEnd_toStartOf="@+id/card_guest_services"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/card_entertainment"
        app:layout_constraintTop_toTopOf="@id/card_entertainment"
        app:strokeColor="@color/premium_card_stroke"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_card_order_food" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_premium_card_scrim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_premium_icon_circle"
                    android:contentDescription="@null"
                    android:padding="16dp"
                    android:src="@drawable/ic_premium_order_food" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/premium_card_order_food"
                    android:textColor="@color/premium_white"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_guest_services"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusDown="@+id/card_message_alerts"
        android:nextFocusLeft="@+id/card_order_food"
        android:foreground="@drawable/focus_border_large"
        android:stateListAnimator="@animator/premium_card_raise"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="@id/card_entertainment"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/card_order_food"
        app:layout_constraintTop_toTopOf="@id/card_entertainment"
        app:strokeColor="@color/premium_card_stroke"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_card_guest_services" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_premium_card_scrim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_premium_icon_circle"
                    android:contentDescription="@null"
                    android:padding="16dp"
                    android:src="@drawable/ic_premium_guest_services" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/premium_card_guest_services"
                    android:textColor="@color/premium_white"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ── BOTTOM ROW: 4 smaller action cards ───────────────────────────── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_live_tv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="10dp"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusLeft="@+id/card_message_alerts"
        android:nextFocusRight="@+id/card_laundry"
        android:nextFocusUp="@+id/card_entertainment"
        android:foreground="@drawable/focus_border"
        android:stateListAnimator="@animator/premium_card_raise"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/card_laundry"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_entertainment"
        app:layout_constraintVertical_weight="0.85"
        app:strokeColor="@color/premium_card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/premium_navy_surface"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_premium_live_tv" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/premium_card_live_tv"
                android:textColor="@color/premium_white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_laundry"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusLeft="@+id/card_live_tv"
        android:nextFocusRight="@+id/card_bell_desk"
        android:nextFocusUp="@+id/card_order_food"
        android:foreground="@drawable/focus_border"
        android:stateListAnimator="@animator/premium_card_raise"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="@id/card_live_tv"
        app:layout_constraintEnd_toStartOf="@+id/card_bell_desk"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/card_live_tv"
        app:layout_constraintTop_toTopOf="@id/card_live_tv"
        app:strokeColor="@color/premium_card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/premium_navy_surface"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_premium_laundry" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/premium_card_laundry"
                android:textColor="@color/premium_white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_bell_desk"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusLeft="@+id/card_laundry"
        android:nextFocusRight="@+id/card_message_alerts"
        android:nextFocusUp="@+id/card_order_food"
        android:foreground="@drawable/focus_border"
        android:stateListAnimator="@animator/premium_card_raise"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="@id/card_live_tv"
        app:layout_constraintEnd_toStartOf="@+id/card_message_alerts"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/card_laundry"
        app:layout_constraintTop_toTopOf="@id/card_live_tv"
        app:strokeColor="@color/premium_card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/premium_navy_surface"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_premium_bell_desk" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/premium_card_bell_desk"
                android:textColor="@color/premium_white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_message_alerts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusLeft="@+id/card_bell_desk"
        android:nextFocusRight="@+id/card_live_tv"
        android:nextFocusUp="@+id/card_guest_services"
        android:foreground="@drawable/focus_border"
        android:stateListAnimator="@animator/premium_card_raise"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="@id/card_live_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/card_bell_desk"
        app:layout_constraintTop_toTopOf="@id/card_live_tv"
        app:strokeColor="@color/premium_card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/premium_navy_surface"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_premium_alerts" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/premium_card_message_alerts"
                android:textColor="@color/premium_white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
