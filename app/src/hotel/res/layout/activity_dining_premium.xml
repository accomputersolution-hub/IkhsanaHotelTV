<?xml version="1.0" encoding="utf-8"?>
<!--
  Hotel-flavor premium In-Room Dining order page.
  Left: food grid · Right: floating translucent cart panel (no gold stroke).
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dining_premium_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dining_navy_deep"
    android:clipChildren="false"
    android:padding="20dp"
    tools:deviceIds="tv">

    <TextView
        android:id="@+id/dining_screen_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="@string/dining_title"
        android:textColor="@color/dining_champagne_gold"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/dining_cart_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/dining_screen_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/dining_subtitle"
        android:textColor="@color/dining_white_muted"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/dining_screen_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dining_screen_title" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dining_menu_grid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="12dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/dining_cart_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dining_screen_subtitle"
        app:spanCount="3"
        tools:listitem="@layout/item_dining_food_card" />

    <!-- Floating cart pane — translucent dark, 16dp radius, NO yellow stroke -->
    <LinearLayout
        android:id="@+id/dining_cart_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_dining_cart_panel"
        android:elevation="10dp"
        android:orientation="vertical"
        android:padding="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.32">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="@string/your_order"
            android:textColor="@color/dining_champagne_gold"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp"
            android:text="@string/order_review"
            android:textColor="@color/dining_white_muted"
            android:textSize="12sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dining_cart_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never" />

        <TextView
            android:id="@+id/dining_cart_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:text="@string/cart_empty"
            android:textColor="@color/dining_white_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/dining_total_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/order_total"
                android:textColor="@color/dining_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dining_cart_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/dining_champagne_gold"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="₹840" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"
            android:text="@string/payment_method_title"
            android:textColor="@color/dining_white_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Bill to Room -->
            <LinearLayout
                android:id="@+id/btn_charge_to_room"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/dining_focus_border"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:stateListAnimator="@animator/dining_focus_scale">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_dining_charge_room" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/pay_at_checkout"
                        android:textColor="@color/dining_white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/pay_at_checkout_sub"
                        android:textColor="@color/dining_white_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Scan & Pay -->
            <LinearLayout
                android:id="@+id/btn_pay_now_qr"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/dining_focus_border"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:stateListAnimator="@animator/dining_focus_scale">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_dining_qr" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/pay_now"
                        android:textColor="@color/dining_white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/pay_now_sub"
                        android:textColor="@color/dining_white_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Main CTA: muted empty · solid gold when cart has items -->
        <TextView
            android:id="@+id/btn_place_order_cta"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/dining_cta_bg"
            android:clickable="true"
            android:enabled="false"
            android:focusable="true"
            android:gravity="center"
            android:stateListAnimator="@animator/dining_focus_scale"
            android:text="@string/cart_add_items_cta"
            android:textColor="@color/dining_cta_text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
