<?xml version="1.0" encoding="utf-8"?>
<!--
  Corporate flavor only.

  applicationId = in.pcncloud.corporate
  namespace / class package = in.pcncloud.hotel

  So MainActivity's real component is:
    in.pcncloud.corporate/in.pcncloud.hotel.MainActivity

  ADB shorthand `in.pcncloud.corporate/.MainActivity` wrongly expands to
    in.pcncloud.corporate/in.pcncloud.corporate.MainActivity
  and throws: "cannot be home on user 0".

  This alias registers that shorthand component as a HOME launcher targeting
  the real MainActivity, so set-home-activity works with either form.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity-alias
            android:name="in.pcncloud.corporate.MainActivity"
            android:targetActivity="in.pcncloud.hotel.MainActivity"
            android:exported="true"
            android:enabled="true"
            android:label="${appName}"
            android:banner="@drawable/pcn_banner"
            android:icon="@drawable/pcn_logo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
