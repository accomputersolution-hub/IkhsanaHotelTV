<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="48dp"
        android:paddingVertical="32dp">

        <ImageView
            android:id="@+id/splash_logo"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/splash_logo_content_description"
            android:scaleType="fitCenter"
            android:src="@drawable/lt_logo"
            tools:src="@drawable/lt_logo" />

        <TextView
            android:id="@+id/splash_welcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:maxLines="3"
            android:text="@string/splash_welcome_loading"
            android:textColor="@color/splash_text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="Welcome to L&amp;T Leadership Development Academy" />

        <TextView
            android:id="@+id/splash_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:text="@string/splash_status_loading"
            android:textAllCaps="false"
            android:textColor="@color/splash_text_muted"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Preparing your experience…" />

        <ProgressBar
            android:id="@+id/splash_progress"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/splash_gold"
            android:indeterminateTintMode="src_in" />

    </LinearLayout>

</FrameLayout>
