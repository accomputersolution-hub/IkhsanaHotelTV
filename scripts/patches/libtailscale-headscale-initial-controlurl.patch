+// headscaleStartOptions builds ipn.Options for the first LocalBackend.Start call.
+func headscaleStartOptions(appCtx AppContext) ipn.Options {
+	opts := ipn.Options{}
+	controlURL, source := embeddedControlURLFromAppCtx(appCtx)
+	if controlURL == "" {
+		log.Printf("libtailscale: LocalBackend.Start with default ControlURL (no embedded URL)")
+		return opts
+	}
+	log.Printf("libtailscale: LocalBackend.Start with ControlURL=%s (from %s)", controlURL, source)
+	opts.UpdatePrefs = &ipn.Prefs{
+		ControlURL:  controlURL,
+		WantRunning: false,
+		LoggedOut:   false,
+	}
+	return opts
+}
+
+func embeddedControlURLFromAppCtx(appCtx AppContext) (string, string) {
+	if url, err := appCtx.DecryptFromPref(customLoginServerPrefKey); err == nil && url != "" {
+		return url, customLoginServerPrefKey + " pref"
+	}
+	return "", ""
+}
+
+func headscaleAssumeNetworkUpForEmbeddedControl(appCtx AppContext) {
+	controlURL, source := embeddedControlURLFromAppCtx(appCtx)
+	if controlURL == "" {
+		return
+	}
+	os.Setenv("TS_ASSUME_NETWORK_UP_FOR_TEST", "1")
+	log.Printf("libtailscale: embedded ControlURL=%s (%s); TS_ASSUME_NETWORK_UP_FOR_TEST=1", controlURL, source)
+}
