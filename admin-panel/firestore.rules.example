rules_version = '2';

// Example Firestore security rules — multi-tenant master admin
// Copy to Firebase Console → Firestore → Rules
//
// ⚠️  DEV ONLY — tighten with Auth custom claims / users/{uid} checks for production.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /Live_Orders/{orderId} {
      allow read, write: if true;
    }

    // Hotel registry + tenant subcollections (keep name "Hotels" for Android sync)
    match /Hotels/{hotelId} {
      allow read, write: if true;

      match /Rooms/{roomNumber} {
        allow read, write: if true;
      }
      match /Menu/{itemId} {
        allow read, write: if true;
      }
      match /Alerts/{alertId} {
        allow read, write: if true;
      }
      match /Broadcasts/{id} {
        allow read, write: if true;
      }
      match /Requests/{id} {
        allow read, write: if true;
      }
      match /Config/{docId} {
        allow read, write: if true;
      }
    }
  }
}
