rules_version = '2';

// Canonical rules live in firestore.rules (deployed via firebase.json).
// This file is kept in sync so README / copy-paste into Console still works.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /{document=**} {
      allow read, write: if signedIn();
    }

    match /users/{userId} {
      allow read, write: if signedIn();
    }

    match /public_hotels/{publicSlug} {
      allow get, list: if true;
      allow create, update, delete: if signedIn();
    }

    match /Hotels/{hotelId}/pairing_codes/{code} {
      allow get: if true;
      allow list: if signedIn();

      allow create: if code.matches('^[0-9]{6}$')
        && request.resource.data.hotelId == hotelId
        && request.resource.data.status == 'pending'
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() >= 16;

      allow update, delete: if signedIn();
    }
  }
}
