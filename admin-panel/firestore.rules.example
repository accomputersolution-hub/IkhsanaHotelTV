rules_version = '2';

// Canonical rules: admin-panel/firestore.rules (deploy via firebase.json).
// TV kiosk has no Firebase Auth — Hotels / public_hotels / pairing_codes
// must be readable (and pairing writable) without request.auth.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if signedIn();
    }

    match /public_hotels/{publicSlug} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /Hotels/{hotelId} {
      allow read: if true;
      allow write: if signedIn();

      match /pairing_codes/{code} {
        allow read, write: if true;
      }

      match /{document=**} {
        allow read, write: if true;
      }
    }

    match /Live_Orders/{orderId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if signedIn();
    }
  }
}
