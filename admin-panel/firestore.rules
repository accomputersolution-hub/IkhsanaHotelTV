rules_version = '2';

// Hostity / Ikhsana Hotel — Firestore security rules
// Deploy: firebase deploy --only firestore:rules --project ikhsana-hotel-tv
//
// Why TV hotel login was failing:
//   The Android TV app has NO Firebase Auth. Pairing + splash + PMS reads
//   use the public Firestore SDK. Rules that only allow signedIn() therefore
//   return PERMISSION_DENIED on:
//     public_hotels/{slug}          (slug lookup)
//     Hotels/{hotelId}              (fallback + splash)
//     Hotels/{hotelId}/pairing_codes
//     Hotels/{hotelId}/Rooms/**     (after claim)
//
// Why admin login was failing:
//   users/{uid} called isSuperAdmin() → get(same users doc). Firestore does
//   not short-circuit OR, so the recursive get denied the entire read.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ── Staff profiles (admin web) ────────────────────────────────────────
    // Do NOT call get() on users/{uid} from inside this match (recursive deny).
    match /users/{userId} {
      allow read, write: if signedIn();
    }

    // ── Public directory — TV pairing slug lookup (no Auth) ───────────────
    match /public_hotels/{publicSlug} {
      allow read: if true;
      allow write: if signedIn();
    }

    // ── Hotel tenant — TV kiosk is unauthenticated ────────────────────────
    match /Hotels/{hotelId} {
      allow read: if true;
      allow write: if signedIn();

      match /pairing_codes/{code} {
        allow read: if true;
        // TV uses set() / set(merge) — that is create or update, not signed-in.
        allow create, update: if true;
        allow delete: if true;
      }

      match /{document=**} {
        allow read: if true;
        allow write: if true;
      }
    }

    // ── Dining orders (top-level collection used by TV + KDS) ─────────────
    match /Live_Orders/{orderId} {
      allow read, write: if true;
    }

    // ── Anything else: signed-in admin ────────────────────────────────────
    match /{document=**} {
      allow read, write: if signedIn();
    }
  }
}
