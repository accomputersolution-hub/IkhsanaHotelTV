rules_version = '2';

// Hostity — Firebase Storage rules for intro/splash videos.
// Publish: Firebase Console → Storage → Rules  (or `firebase deploy --only storage`)
//
// Without these (default deny), browser uploads stick at 0% then fail with
// storage/unauthorized.

service firebase.storage {
  match /b/{bucket}/o {
    // Intro / splash MP4s used by the admin panel + TV kiosk.
    match /hotels/{hotelId}/intro/{fileName} {
      // Download URLs include a token; allow read for TV players / previews.
      allow read: if true;

      // Only signed-in staff may upload/replace/delete.
      allow write: if request.auth != null
        && request.resource.size < 80 * 1024 * 1024
        && (
          request.resource.contentType == null
          || request.resource.contentType.matches('video/.*')
        );

      allow delete: if request.auth != null;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
